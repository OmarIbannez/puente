# Puente configuration. Copy to .env and adjust; every variable is optional
# except DATABASE_URL. Flags of `puente <command>` override these.

# PostgreSQL connection string (every command). `just dev` sets it for the
# docker compose database on PUENTE_DB_PORT.
DATABASE_URL=postgres://puente:puente@localhost:5435/puente?sslmode=disable

# Host port of the docker compose database (justfile only). Default 5435.
PUENTE_DB_PORT=5435

# HTTP port of `puente serve` (listens on :$PORT). Default 8000.
PORT=8000

# Built web app (`npm --prefix web run build` writes web/dist). Unset, or a
# directory without index.html, serves a built-in placeholder page.
PUENTE_STATIC_DIR=web/dist

# Seed every new visitor sandbox with the demo world (customers, deposits,
# payouts in every state). Default true.
PUENTE_SEED_DEMO=true

# Override the fixed demo USDC rate, in MXN per USDC (six decimals at most).
# Default 18.4523.
# PUENTE_USDC_MXN_RATE=18.4523

# --- Live mode (optional, read-only) ---------------------------------------
# The live sandbox follows real testnets. It is on when the watch address and
# at least one RPC URL are set; an unreachable RPC is logged and skipped, it
# never stops the server.

# Address watched on every configured live network.
# PUENTE_LIVE_WATCH_ADDRESS=0x...

# JSON-RPC URL for Base Sepolia (Circle USDC), e.g. https://sepolia.base.org
# PUENTE_LIVE_USDC_RPC=

# JSON-RPC URL for Arbitrum Sepolia (Bitso MXNB), e.g.
# https://sepolia-rollup.arbitrum.io/rpc
# PUENTE_LIVE_MXNB_RPC=

# Blocks before a live deposit counts as confirmed. Default 5.
# PUENTE_LIVE_CONFIRMATIONS=5

# --- Operator only ---------------------------------------------------------
# Hex private key of the testnet hot wallet, read only by `puente chain send`
# (which also needs --yes). The HTTP API never reads it. Never commit a real
# key; use a throwaway testnet wallet.
# PUENTE_HOT_WALLET_KEY=

# Host port of the app container in `docker compose up` (default 8000).
# PUENTE_PORT=8000
